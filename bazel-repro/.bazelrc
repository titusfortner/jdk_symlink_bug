# Trigger flags. Omit any one of these and the bug is expected to vanish:
#
#   --legacy_external_runfiles   legacy runfiles layout (default-on in Bazel 7,
#                                must be explicit in Bazel 8+)
#   --windows_enable_symlinks    create real NTFS symlinks instead of copies
#   --enable_runfiles            build a symlinked runfiles *tree* (not a
#                                manifest-only / copy layout)
#
# Together these make the runfiles JDK's bin\server\classes.jsa a symlink, which
# is the condition the JVM crashes on during CDS mmap at startup.
common --legacy_external_runfiles
startup --windows_enable_symlinks
build --enable_runfiles

# Use the rules_java remote JDK 25 (Azul Zulu on Windows) for both the target
# and the tools. Vendor matters: the crash reproduces on Zulu, not Temurin.
build --java_language_version=25
build --java_runtime_version=remotejdk_25
build --tool_java_language_version=25
build --tool_java_runtime_version=remotejdk_25
